{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://theforge.dev/schemas/session.json",
  "title": "Session Card Schema",
  "description": "JSON Schema for cognitive forge session cards (debates, explorations)",
  "type": "object",
  "required": ["title", "type", "session_type", "topic", "created", "updated"],
  "properties": {
    "title": {
      "type": "string",
      "description": "Session title",
      "minLength": 1,
      "maxLength": 200
    },
    "type": {
      "type": "string",
      "const": "session",
      "description": "Card type identifier"
    },
    "session_type": {
      "type": "string",
      "enum": ["debate", "exploration"],
      "description": "Type of cognitive forge session"
    },
    "topic": {
      "type": "string",
      "description": "Main topic or question being explored",
      "minLength": 1
    },
    "agents": {
      "type": "array",
      "description": "List of agents participating in the session",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": ["Active", "Paused", "Completed"],
      "description": "Current status of the session",
      "default": "Active"
    },
    "rounds": {
      "type": ["integer", "null"],
      "description": "Number of rounds completed",
      "minimum": 0,
      "default": null
    },
    "created": {
      "type": "string",
      "format": "date",
      "description": "Creation date in YYYY-MM-DD format"
    },
    "updated": {
      "type": "string",
      "format": "date",
      "description": "Last update date in YYYY-MM-DD format"
    },
    "session_log": {
      "type": "string",
      "description": "Full session narrative"
    },
    "synthesis": {
      "type": "string",
      "description": "Integrated analysis from all perspectives"
    },
    "key_insights": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "next_steps": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "category": {
      "type": "string",
      "enum": ["Business", "Philosophical", "Framework", "Creative"]
    },
    "relationship": {
      "type": "string",
      "enum": ["creator", "evaluator", "inheritor"]
    },
    "techniques_applied": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    }
  },
  "additionalProperties": false
}
