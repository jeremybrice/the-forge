{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://theforge.dev/schemas/story.json",
  "title": "Story Card Schema",
  "description": "JSON Schema for Story-level implementation task cards",
  "type": "object",
  "required": ["title", "type", "status", "product", "created", "updated"],
  "properties": {
    "title": {
      "type": "string",
      "description": "Concise description of the story",
      "minLength": 1,
      "maxLength": 200
    },
    "type": {
      "type": "string",
      "const": "story",
      "description": "Card type identifier"
    },
    "status": {
      "type": "string",
      "enum": ["Draft", "Ready", "In Progress", "In Review", "Testing", "Done", "Blocked"],
      "description": "Current status of the story"
    },
    "product": {
      "type": "string",
      "description": "Product from taxonomy",
      "minLength": 1
    },
    "module": {
      "type": ["string", "null"],
      "description": "Module from taxonomy",
      "default": null
    },
    "client": {
      "type": ["string", "null"],
      "description": "Client from taxonomy",
      "default": null
    },
    "team": {
      "type": ["string", "null"],
      "description": "Team responsible for the story",
      "default": null
    },
    "parent": {
      "type": ["string", "null"],
      "description": "Parent epic filename (without extension)",
      "default": null
    },
    "story_points": {
      "type": ["integer", "null"],
      "description": "Story points estimate (1, 2, 3, 5, 8, 13)",
      "enum": [1, 2, 3, 5, 8, 13, null],
      "default": null
    },
    "jira_card": {
      "type": ["string", "null"],
      "description": "Link to Jira story or ticket",
      "default": null
    },
    "source_conversation": {
      "type": ["string", "null"],
      "description": "Link to planning conversation",
      "default": null
    },
    "created": {
      "type": "string",
      "format": "date",
      "description": "Creation date in YYYY-MM-DD format"
    },
    "updated": {
      "type": "string",
      "format": "date",
      "description": "Last update date in YYYY-MM-DD format"
    }
  },
  "additionalProperties": false
}
