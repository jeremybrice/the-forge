{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://theforge.dev/schemas/release-note.json",
  "title": "Release Notes Card Schema",
  "description": "JSON Schema for product release notes",
  "type": "object",
  "required": ["title", "type", "product", "version", "release_date", "created", "updated"],
  "properties": {
    "title": {
      "type": "string",
      "description": "Title of the release (e.g., WebApp Release 260208)",
      "minLength": 1,
      "maxLength": 200
    },
    "type": {
      "type": "string",
      "const": "release-note",
      "description": "Card type identifier"
    },
    "product": {
      "type": "string",
      "description": "Product from taxonomy",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "description": "Release version identifier",
      "minLength": 1
    },
    "release_date": {
      "type": "string",
      "format": "date",
      "description": "Release date in YYYY-MM-DD format"
    },
    "created": {
      "type": "string",
      "format": "date",
      "description": "Creation date in YYYY-MM-DD format"
    },
    "updated": {
      "type": "string",
      "format": "date",
      "description": "Last update date in YYYY-MM-DD format"
    },
    "files": {
      "type": ["object", "null"],
      "description": "Generated Word packages beside this card in cards/release-notes/. Read by forge-lib/scripts/document_artifact_audit.py to pair each docx with its source card.",
      "properties": {
        "internal": {"type": ["string", "null"], "description": "Internal release-notes docx filename"},
        "external": {"type": ["string", "null"], "description": "External release-notes docx filename"}
      },
      "additionalProperties": false
    },
    "source": {
      "type": ["string", "null"],
      "description": "Confluence page or other upstream the notes were generated from"
    },
    "status": {
      "type": ["string", "null"],
      "description": "Optional publication status (e.g., Published)"
    },
    "module": {
      "type": ["string", "null"],
      "description": "Module from taxonomy, when the release is module-scoped"
    },
    "client": {
      "type": ["string", "null"],
      "description": "Client from taxonomy, when the release is client-specific"
    }
  },
  "additionalProperties": false
}
